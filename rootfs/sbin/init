#!/bin/sh
# K1OS /sbin/init — stage 2, PID 1 после switch_root
# Виртуальные ФС уже смонтированы initramfs-ом

# Locale
export LANG=C
export LC_ALL=C

# Hostname
echo "k1os" > /proc/sys/kernel/hostname

# tmpfs для /tmp и /run (если ещё не смонтированы)
mount -t tmpfs -o size=75% none /tmp  2>/dev/null || true
mount -t tmpfs -o size=10% none /run  2>/dev/null || true

# Loopback
ip link set lo up 2>/dev/null || true

# Обработчики сигналов — reboot/poweroff/halt
do_reboot()  { echo "[k1os] Rebooting...";  sync; reboot -f; }
do_poweroff(){ echo "[k1os] Powering off..."; sync; poweroff -f; }

trap do_reboot  TERM
trap do_poweroff INT

# Запускаем runsvdir (runit сервисы)
runsvdir /var/service &

# Приветствие на консолях
for tty in /dev/tty1 /dev/ttyS0; do
    [ -c "$tty" ] && cat /etc/issue > "$tty" 2>/dev/null || true
done

# getty на tty1 и ttyS0
/sbin/getty -n -l /usr/bin/fish 115200 ttyS0 &
/sbin/getty -n -l /usr/bin/fish 38400 tty1 &

# PID 1 ждёт — обрабатывает сигналы
while true; do
    wait
done
