#!/bin/sh
# K1OS /init — PID 1

# Монтируем виртуальные ФС
mount -t proc     none /proc
mount -t sysfs    none /sys
mount -t devtmpfs none /dev 2>/dev/null || mdev -s
mkdir -p /dev/pts
mount -t devpts   none /dev/pts
mount -t tmpfs    -o size=75% none /tmp
mount -t tmpfs    -o size=10% none /run

# Hostname
echo "k1os" > /proc/sys/kernel/hostname

# Loopback
ip link set lo up 2>/dev/null || true

# Запускаем runsvdir в фоне
runsvdir /var/service &

# Приветствие на всех консолях
for tty in /dev/tty1 /dev/ttyS0; do
    [ -c "$tty" ] && cat /etc/issue > "$tty" 2>/dev/null || true
done

# Запускаем getty на tty1 (VGA) и ttyS0 (serial) одновременно
/sbin/getty -n -l /usr/bin/fish 115200 ttyS0 &
exec /sbin/getty -n -l /usr/bin/fish 38400 tty1
